{
  "name": "@grade-management/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply grade-management --local --config ../../wrangler.jsonc",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "@cloudflare/workers-types": "5.20260809.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "drizzle-kit": "0.31.8",
    "wrangler": "4.120.0",
    "typescript": "5.9.3"
  }
}
