{
  "name": "grade-management",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:api": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts && bun scripts/generate-wrangler-deploy-config.ts",
    "validate:production": "bun scripts/validate-production-config.ts",
    "deploy": "bun run build && bun run validate:production && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test scripts && bun --filter '*' test",
    "db:generate": "bun --filter @grade-management/db db:generate",
    "db:migrate": "wrangler d1 migrations apply grade-management --local --persist-to apps/web/.wrangler/state --config wrangler.jsonc",
    "db:studio": "bun --filter @grade-management/db db:studio",
    "admin:create": "bun scripts/create-admin.ts",
    "dev:seed": "bun scripts/seed-dev.ts",
    "e2e:prepare": "bun scripts/e2e-prepare.ts",
    "e2e:serve": "bun scripts/e2e-serve.ts",
    "e2e:test": "bun scripts/e2e-run.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "6.0.5",
    "better-auth": "1.6.23",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  }
}
