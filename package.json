{
  "name": "grade-management",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:web": "bun --filter @grade-management/web dev",
    "dev:api": "bun --filter @grade-management/api dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "db:generate": "bun --filter @grade-management/db db:generate",
    "db:migrate": "bun --filter @grade-management/db db:migrate",
    "db:studio": "bun --filter @grade-management/db db:studio"
  }
}
